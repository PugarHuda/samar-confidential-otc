# Copy to .env.local. The values below are the live Sepolia deployment — the app works as-is.

# WalletConnect Cloud project id (free: https://cloud.walletconnect.com). Optional — MetaMask works without it.
NEXT_PUBLIC_WALLETCONNECT_ID=a0197aa49d08f0b2e34186c8a67c733c

# Deployed contract addresses (Sepolia). Redeploy with `npm run deploy:sepolia` in packages/contracts.
NEXT_PUBLIC_CUSDC=0x6BC0f17C25505795E441D9bCd1A5E0331eB5097e
NEXT_PUBLIC_CETH=0x0700c9300D5cfD8A4b2C7fBbaB2703087AB0590c
NEXT_PUBLIC_PRIVATE_OTC=0x7bde6aC99D3Df939941232159b2E675ACBD5A932

# Optional — override the default public Sepolia RPC.
# NEXT_PUBLIC_SEPOLIA_RPC=
